# Copy this file to .env and replace the example secrets before running.
# Do not commit .env to Git.

# Database
DB_NAME=library_management
DB_USERNAME=root
DB_PASSWORD=root
DB_ROOT_PASSWORD=root

# Used when running Spring Boot directly on your computer.
# Docker Compose overrides DB_URL for the app container to use the mysql service.
DB_URL=jdbc:mysql://localhost:3306/library_management

